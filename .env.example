# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Live translation (shown under each transcript line; display only) ---
# Translation never uses Gemini and never spends Gemini tokens.
#
# Optional. Set this to use the official Cloud Translation API instead of the
# unofficial endpoints: 500,000 characters/month free, then $20/million.
# Enable "Cloud Translation API" in a GCP project and create an API key:
#   https://console.cloud.google.com/apis/library/translate.googleapis.com
# Leave it blank to keep the zero-setup path (unofficial endpoints, no key).
# GOOGLE_TRANSLATE_API_KEY=

# TRANSLATION_ENABLED=true
# auto = official API when a key is set, then the unofficial endpoints.
# Pin one stage with: cloud | single | batch | off
# TRANSLATION_PROVIDER=auto
# TRANSLATION_TARGET_LANG=zh-CN
# TRANSLATION_TIMEOUT=3.0
# How long a transcript line waits for its translation before printing without one.
# TRANSLATION_MAX_HOLD_SECONDS=3.0
# TRANSLATION_WORKERS=1

# --- Transcript flush cadence (Windows Live Captions) ---
# TRANSCRIPT_MIN_FLUSH_SECONDS=1.5
# TRANSCRIPT_MAX_FLUSH_SECONDS=6.0
# ADVICE_CONTEXT_ENTRIES=40
